/* styles/settings_dialog.qss */

/* 메인 배경 */
.SettingsDialog {
    background-color: #2d3033;
    border-radius: 10px;
    padding: 18px;
}

/* 제목 */
#DialogTitle {
    font-size: 18px;
    font-weight: 600;
    color: #f0f0f0;
}

/* 상단 닫기 버튼 */
#CloseButton {
    background: transparent;
    color: #cfd2d6;
    font-size: 16px;
    padding: 6px 10px;
    border-radius: 6px;
}
#CloseButton:hover {
    background: rgba(255,255,255,0.12);
    color: white;
}

/* 라벨 */
QLabel {
    color: #d8d8dd;
    font-size: 14px;
    font-weight: 500;
}

/* 입력 박스 */
QLineEdit {
    background-color: #1f2124;
    color: white;
    padding: 8px;
    border: 1px solid #3a3d42;
    border-radius: 6px;
}
QLineEdit:focus {
    border: 1px solid #6b7dff;
}

/* 버튼 */
QPushButton {
    background-color: #3a3d42;
    padding: 6px 18px;
    border-radius: 6px;
    color: white;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #4f545c;
}
QPushButton:pressed {
    background-color: #2b2d31;
}
